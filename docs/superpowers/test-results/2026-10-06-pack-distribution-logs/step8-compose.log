== docker-compose.yml services: ['dashboard', 'indexer', 'kg-bridge', 'kg-pack-registry', 'kg-server', 'postgres', 'redis', 'worker'] volumes: ['ennam_uploads', 'hf_cache', 'packs_registry', 'postgres_data']
  kg-server: image=None build=yes entrypoint=None ports=['${KG_SERVER_PORT:-8080}:8080'] env={'PACKS_DIR': '/packs', 'PACKS_SOURCE': '${PACKS_SOURCE:-}', 'PACKS_TOKEN': '${PACKS_TOKEN:-}'} vols=['${PACKS_HOST_DIR:-./packs}:/packs'] health=yes networks=['ennam-kg']
  kg-pack-registry: image=None build=yes entrypoint=['/app/kg-pack-registry'] ports=['${KG_PACKS_PORT:-8090}:8090'] env={'KG_PACKS_STORAGE_DIR': '/data/packs', 'KG_PACKS_READ_TOKEN': '${KG_PACKS_READ_TOKEN:-}', 'KG_PACKS_PUBLISH_TOKEN': '${KG_PACKS_PUBLISH_TOKEN:-}'} vols=['packs_registry:/data/packs'] health=yes networks=['ennam-kg']
== docker-compose.release.yml services: ['dashboard', 'indexer', 'kg-bridge', 'kg-pack-registry', 'kg-server', 'postgres', 'redis', 'worker'] volumes: ['ennam_uploads', 'packs_registry', 'postgres_data']
  kg-server: image=${KG_IMAGE_PREFIX:-}daab-server:${KG_RELEASE_TAG:-v2.5.0} build=no entrypoint=None ports=['${KG_SERVER_PORT:-8080}:8080'] env={'PACKS_DIR': '/packs', 'PACKS_SOURCE': '${PACKS_SOURCE:-}', 'PACKS_TOKEN': '${PACKS_TOKEN:-}'} vols=['${PACKS_HOST_DIR:-./packs}:/packs'] health=yes networks=['ennam-kg']
  kg-pack-registry: image=${KG_IMAGE_PREFIX:-}daab-server:${KG_RELEASE_TAG:-v2.5.0} build=no entrypoint=['/app/kg-pack-registry'] ports=['${KG_PACKS_PORT:-8090}:8090'] env={'KG_PACKS_STORAGE_DIR': '/data/packs', 'KG_PACKS_READ_TOKEN': '${KG_PACKS_READ_TOKEN:-}', 'KG_PACKS_PUBLISH_TOKEN': '${KG_PACKS_PUBLISH_TOKEN:-}'} vols=['packs_registry:/data/packs'] health=yes networks=['ennam-kg']
== LAAM/docker-compose.yml services: ['adminer', 'app', 'searxng', 'tick', 'vieneu-tts'] volumes: []
  app: image=laam-app:latest build=no entrypoint=None ports=['3900:3000'] env={'PACKS_DIR': '/packs', 'PACKS_SOURCE': '${PACKS_SOURCE:-}', 'PACKS_TOKEN': '${PACKS_TOKEN:-}'} vols=['${PACKS_HOST_DIR:-../packs}:/packs'] health=no networks=['default', 'ecosystem-net']
