# Ennam KG — release bundle environment (docker-compose.release.yml)
# Copy to `.env` and fill in. NEVER commit a real .env.

# --- Image tag to run (must already be built / pulled) ---
KG_RELEASE_TAG=v1.0.0

# --- Database ---
KG_DB_NAME=ennam_kg
KG_DB_USER=ennam_kg
KG_DB_PASSWORD=            # REQUIRED — choose a strong password

# --- Auth ---
# Bearer token presented by indexer/worker/dashboard to the Go API. It must
# correspond to a row in the api_keys table. Migration 000009 seeds a well-known
# DEV admin key (plaintext: ennam_kg_dev_000000000000000000000000) — usable for
# local/testing ONLY. ROTATE IT for any real deployment (create a fresh admin key,
# then revoke the seeded one).
KG_API_KEY=               # REQUIRED

# AES-256-GCM key for credential + AI-provider-key encryption.
# Generate: openssl rand -base64 32   (32 raw bytes, base64-encoded)
KG_ENCRYPTION_KEY=        # REQUIRED

# Dashboard iron-session secret, >= 32 chars.  Generate: openssl rand -hex 24
SESSION_SECRET=           # REQUIRED

# --- Optional ---
ANTHROPIC_API_KEY=        # enables AI summarization / NL-query; degrades gracefully if unset
KG_LOG_LEVEL=info
# Host port overrides (defaults shown)
# KG_SERVER_PORT=8080
# KG_INDEXER_PORT=8081
# KG_DASHBOARD_PORT=3500
# KG_DB_PORT=5432
# KG_REDIS_PORT=6379
