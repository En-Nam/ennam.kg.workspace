# =============================================================================
# Ennam Knowledge Graph Platform — Local Environment
# =============================================================================
# Copy to .env:  cp .env.example .env
# Used by the root docker-compose.yml to start all services.

# PostgreSQL
KG_DB_NAME=ennam_kg
KG_DB_USER=ennam_kg
KG_DB_PASSWORD=ennam_kg_dev
KG_DB_PORT=5432

# Redis
KG_REDIS_PORT=6379

# Go API Server
KG_SERVER_PORT=8080
KG_LOG_LEVEL=debug
KG_API_KEY=ennam_kg_dev_000000000000000000000000
KG_AUTH_NOOP=false

# Python Indexer
KG_INDEXER_PORT=8081

# NextJS Dashboard
KG_DASHBOARD_PORT=3500
SESSION_SECRET=ennam-kg-dev-session-secret-32chars!!

# Ennam-owned AI keys. The server provisions the catalog models from these at startup (Claude from
# ANTHROPIC_API_KEY, BytePlus from BYTEPLUS_API_KEY); a family whose key is empty is left as it is. Customers do not
# enter keys of their own: KG_ALLOW_CUSTOM_AI_PROVIDERS=false (the default) rejects adding a provider or key through
# the API. Set it to true only for local experiments.
ANTHROPIC_API_KEY=
BYTEPLUS_API_KEY=
KG_ALLOW_CUSTOM_AI_PROVIDERS=false

# TypeSafe Jev table judge (picks the tables a question needs before planning). An empty key = Jev unavailable.
# Setting the key only makes Jev available: no project uses it until a system admin opts that project in
# (jev_allowed, default off), and the global ai.judge.table_filter setting picks off/shadow/on for opted-in projects.
# What leaves the server: the PII-masked question, table names, table descriptions and column names. Never row data.
# Customer projects: opt in only after TypeSafe's DPA is reviewed with zero data retention, the customer has agreed,
# and shadow results on our own data meet the bar. Dev/demo projects (our own data) may be opted in freely.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_MS=800
